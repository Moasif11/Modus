# ==========================================
# MODUS ERP - Environment Configuration
# ==========================================

# 1. Database Configuration (PostgreSQL / NeonDB / Supabase / Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modus_erp?sslmode=disable

# Application Base URL
APP_URL=http://localhost:4000

# Seeding Secret (Used to protect initial database setup /api/auth/seed)
SEED_SECRET=change-me-to-a-secure-random-seed-secret

# 2. Email Service (Choose SMTP or Resend)
# Option A: Standard SMTP (Hostinger, Gmail, Sendgrid, Postmark, AWS SES)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="MODUS ERP <notifications@yourdomain.com>"

# Option B: Resend (Optional transactional email API)
RESEND_API_KEY=

# 3. Object Storage (Cloudflare R2, AWS S3, or MinIO)
# Used for storing uploaded invoices, client documents, receipts
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=modus-documents
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<id>.r2.dev

# 4. Image Storage (Cloudinary - Optional)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 5. Local PDF Rendering
# Path to Chromium or Google Chrome binary on your host server
CHROMIUM_EXECUTABLE_PATH=

# 6. Optional AI Features (Resume Parsing & Receipt Scanning)
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general
